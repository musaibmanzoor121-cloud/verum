# Copy this file to `.env` to override defaults when running the backend locally.
# All values shown are the defaults.

# Engine A: set to true ONLY if you installed torch + transformers and want
# real GPT-2 perplexity. Leave false for the fast, deploy-friendly mode.
USE_TRANSFORMER_PERPLEXITY=false
PERPLEXITY_MODEL=gpt2

# Engine B: submissions faster than this many seconds are flagged.
MIN_SUBMIT_SECONDS=3.0

# Rate limiting (per IP).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated frontend origins allowed to call the API in the browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: set to enable Redis-backed rate limiting for multi-instance deploys.
# REDIS_URL=redis://localhost:6379/0
